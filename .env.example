# NavSphere navigation API — server environment configuration.
#
# Copy this file to `.env` for local runs (uvicorn does not load `.env`
# automatically; use `--env-file .env` or export the variables) and set the
# same variables as private variables in Railway.
#
# None of these values are secrets. Any truly secret credential must stay
# server-side and must NEVER be committed.

# Run mode: "development" | "production"
ENVIRONMENT=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory (relative to the repo root) that holds the trained artifacts
# (D-T2/D-T3/D-T4/D-T5 checkpoints and joblib models).
MODEL_DIRECTORY=models

# Engine configuration files (relative to the repo root).
NAVIGATION_CONFIG=configs/navigation_config.yaml
FUSION_CONFIG=configs/fusion_config.yaml
MAP_MATCHING_CONFIG=configs/map_matching_config.yaml

# In-memory session capacity and idle timeout (seconds).
MAX_SESSIONS=8
SESSION_IDLE_TIMEOUT_S=1800

# Comma-separated list of allowed CORS origins ("*" is the safe local default;
# the native mobile client does not enforce CORS).
CORS_ORIGINS=*

# Port/host defaults are not read from env by this repo's config — uvicorn is
# launched explicitly, e.g. `--host 0.0.0.0 --port $PORT` on Railway.