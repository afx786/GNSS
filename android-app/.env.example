# NavSphere mobile app — environment configuration
#
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored;
# never commit real keys.
#
# All variables are EXPO_PUBLIC_* so they are inlined by Expo at build time and
# ship inside the client binary. Treat them as public client configuration —
# any truly secret credential must be kept server-side and proxied; do not put
# it here.

# GraphHopper API base URL (default: https://graphhopper.com/api/1)
EXPO_PUBLIC_GRAPHHOPPER_API_URL=https://graphhopper.com/api/1

# GraphHopper public API key (read-only, rate-limited).
# Required for real routing + geocoding. When blank, the app still runs but
# search/routing surfaces an explanatory "not configured" message.
# Replace the placeholder with your own key in `.env` (never commit it).
EXPO_PUBLIC_GRAPHHOPPER_API_KEY=your_graphhopper_api_key_here

# Default map style id, matching keys in config/map.ts (liberty, bright,
# positron, dark, fiord, satellite).
EXPO_PUBLIC_DEFAULT_MAP_STYLE=liberty

# Build environment marker: "development" | "production"
EXPO_PUBLIC_APP_ENV=development

# Navigation backend API base URL (FastAPI). When blank, the backend-powered
# IDR/dead-reckoning provider stays disabled and the app uses GNSS only.
# Point this at the deployed service, or http://<dev-machine-ip>:8000 during
# local development (expo start from the same Wi-Fi).
EXPO_PUBLIC_NAVIGATION_API_URL=